{
  "name": "codex-app-server-bridge",
  "private": true,
  "description": "让本机 Codex CLI 与 ChatGPT Remote 复用 ChatGPT Desktop 的 App Server",
  "type": "module",
  "scripts": {
    "inst": "node scripts/inst.mjs",
    "uninst": "node scripts/uninst.mjs",
    "status": "node src/status.mjs",
    "logs": "node src/logs.mjs",
    "diag:arm": "node scripts/launcher-diagnostics.mjs arm",
    "diag:disable": "node scripts/launcher-diagnostics.mjs disable",
    "diag:show": "node scripts/launcher-diagnostics.mjs show",
    "diag:clear": "node scripts/launcher-diagnostics.mjs clear",
    "install-runtime": "node scripts/install.mjs",
    "test": "node --test",
    "check": "node --check src/*.mjs && node --check scripts/*.mjs && node --check scripts/lib/*.mjs && node --check test/*.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
